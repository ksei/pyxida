# Optional settings for running Pyxida directly (python app.py).
# No API key is needed; Pyxida uses your Codex ChatGPT sign-in.

# Only needed if the Codex CLI cannot be found automatically:
# CODEX_BIN=/absolute/path/to/codex
# Only needed to override the Codex default model:
# CODEX_MODEL=your-preferred-codex-model

# Network use (the Docker image sets HOST=0.0.0.0 for you):
# HOST=0.0.0.0
# PORT=8765
# APP_PASSWORD=choose-a-long-password      # required when HOST is not 127.0.0.1
# ALLOWED_HOSTS=pyxida.home.lan,192.168.1.20:8765
# DATA_DIR=/absolute/path/for/profiles
